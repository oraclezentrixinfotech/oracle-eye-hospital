generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PostType {
  BLOG
  NEWS
}

enum UserRole {
  ADMIN
}

// Admin login (hashed password stored in PostgreSQL)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Patient appointment requests from the website form
model Appointment {
  id            String            @id @default(cuid())
  name          String
  phone         String
  email         String?
  doctor        String?
  service       String?
  preferredDate DateTime?
  message       String?
  status        AppointmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())

  @@index([status, createdAt])
}

// Contact page messages
model Enquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Blogs and News & Events share one table (type decides where it shows)
model Post {
  id        String   @id @default(cuid())
  type      PostType @default(BLOG)
  slug      String   @unique
  title     String
  excerpt   String
  body      String
  image     String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([type, published, createdAt])
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Photo {
  id        Int      @id @default(autoincrement())
  title     String
  image     String
  status    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
}

model Doctor {
  id            Int      @id @default(autoincrement())
  name          String
  role          String?
  qualification String?
  image         String?
  bio           String?
  badgeText     String?  @map("badge_text")
  profileHref   String?  @map("profile_href")
  sortOrder     Int      @default(0) @map("sort_order")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("doctors")
}

model SeoPage {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  status          String   @default("draft")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  keywords        String?
  canonicalUrl    String?  @map("canonical_url")
  ogImage         String?  @map("og_image")
  heroBadge       String?  @map("hero_badge")
  h1Title         String   @map("h1_title")
  heroSubtitle    String?  @map("hero_subtitle")
  heroImage       String?  @map("hero_image")
  heroChips       Json?    @default("[]") @map("hero_chips")
  ctaPrimaryText  String?  @default("Book Consultation") @map("cta_primary_text")
  ctaPrimaryLink  String?  @default("https://www.oracleeyehospital.com/") @map("cta_primary_link")
  ctaPhone        String?  @default("+919458422606") @map("cta_phone")
  sections        Json?    @default("[]")
  doctorIds       Int[]    @default([]) @map("doctor_ids")
  faqs            Json?     @default("[]")
  customSchema    String?   @db.Text @map("custom_schema")
  schemaJson      Json?     @map("schema_json")
  schemaUpdatedAt DateTime? @map("schema_updated_at")
  relatedIds      Int[]     @default([]) @map("related_ids")
  customLinks     Json?     @default("[]") @map("custom_links")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, slug])
  @@map("seo_pages")
}